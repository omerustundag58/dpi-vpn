# Android NDK bağlayıcı ayarı — ÖRNEK.
# Kullanım: bu dosyayı `.cargo/config.toml` adıyla kopyala ve NDK yolunu
# kendi makineye göre düzelt (yerel dosya git'e girmez).
# NDK r27, API 26 clang, 16KB sayfa (Android 15+ uyumu).
# F-Droid kendi NDK yolunu üretir.
[target.x86_64-linux-android]
linker = "<SDK>/ndk/27.2.12479018/toolchains/llvm/prebuilt/windows-x86_64/bin/x86_64-linux-android26-clang.cmd"
ar = "<SDK>/ndk/27.2.12479018/toolchains/llvm/prebuilt/windows-x86_64/bin/llvm-ar.exe"
rustflags = ["-C", "link-arg=-Wl,-z,max-page-size=16384"]

[target.aarch64-linux-android]
linker = "<SDK>/ndk/27.2.12479018/toolchains/llvm/prebuilt/windows-x86_64/bin/aarch64-linux-android26-clang.cmd"
ar = "<SDK>/ndk/27.2.12479018/toolchains/llvm/prebuilt/windows-x86_64/bin/llvm-ar.exe"
rustflags = ["-C", "link-arg=-Wl,-z,max-page-size=16384"]
