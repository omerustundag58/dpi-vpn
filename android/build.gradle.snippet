# DpiVpnService icin gerekli Gradle + Manifest parcalari (minSdk/abiFilters/service tanimi).
# --- app/build.gradle icine ekleyin: ---
# android { defaultConfig { minSdk 29 } ndkVersion "26.1.10909125"
#   sourceSets { main { jniLibs.srcDirs += ["../jniLibs"] } } }
# dependencies { implementation "androidx.core:core-ktx:1.12.0" }
# --- AndroidManifest.xml icine ekleyin: ---
# <uses-permission android:name="android.permission.BIND_VPN_SERVICE" />
# <service android:name=".DpiVpnService" android:exported="false"
#   android:permission="android.permission.BIND_VPN_SERVICE">
#   <intent-filter><action android:name="android.net.VpnService" /></intent-filter>
# </service>
# --- cargo-ndk ile Rust .so uretimi: ---
# rustup target add aarch64-linux-android armv7-linux-androideabi x86_64-linux-android
# cargo install cargo-ndk && cargo ndk -t arm64-v8a -o android/jniLibs build -p dpi-core
